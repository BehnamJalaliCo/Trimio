<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark canvas from the first frame so launch never flashes white before Compose draws. -->
    <style name="Theme.Trimio" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/trimio_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
